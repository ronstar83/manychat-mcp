MANYCHAT_API_TOKEN=your_manychat_api_token_here
PORT=3000

# Required for sending WhatsApp messages via manychat_send_content.
# ManyChat rejects direct sendContent for WhatsApp, so the server writes the
# reply text into a custom field and triggers a flow that sends that field.
# ID of the custom field that holds the reply text (numeric, see manychat_list_custom_fields):
MANYCHAT_WHATSAPP_REPLY_FIELD_ID=
# Namespace of the flow that sends the field content to the subscriber (see manychat_list_flows):
MANYCHAT_WHATSAPP_REPLY_FLOW_NS=
